                "exec": [
                  "const expectedMethod = \"POST\"; // Assumption: update if your request method is GET/PUT/etc.\r",
                  "const responseText = pm.response.text();\r",
                  "\r",
                  "function containsSensitiveKeyOrValue(obj) {\r",
                  "    const sensitivePatterns = [\r",
                  "        /password/i,\r",
                  "        /secret/i,\r",
                  "        /token/i,\r",
                  "        /authorization/i,\r",
                  "        /api[-_]?key/i,\r",
                  "        /private[-_]?key/i,\r",
                  "        /session[-_]?id/i,\r",
                  "        /\\botp\\b/i,\r",
                  "        /\\bpin\\b/i,\r",
                  "        /\\bcvv\\b/i,\r",
                  "        /cardNumber/i,\r",
                  "        /nationalId/i\r",
                  "    ];\r",
                  "\r",
                  "    const text = typeof obj === \"string\" ? obj : JSON.stringify(obj);\r",
                  "\r",
                  "    return sensitivePatterns.some(function (pattern) {\r",
                  "        return pattern.test(text);\r",
                  "    });\r",
                  "}\r",
                  "\r",
                  "pm.test(\"1. Status code is 200\", function () {\r",
                  "    pm.expect(\r",
                  "        pm.response.code,\r",
                  "        \"Expected successful response, but API returned \" + pm.response.code\r",
                  "    ).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"2. Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"3. Request method is correct\", function () {\r",
                  "    pm.expect(pm.request.method).to.eql(expectedMethod);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"4. Response should be JSON, not HTML error page\", function () {\r",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";\r",
                  "\r",
                  "    pm.expect(\r",
                  "        contentType.toLowerCase(),\r",
                  "        \"Expected JSON response but received: \" + contentType\r",
                  "    ).to.include(\"application/json\");\r",
                  "\r",
                  "    pm.expect(\r",
                  "        responseText,\r",
                  "        \"Response contains ASP.NET 404 HTML error page\"\r",
                  "    ).to.not.include(\"The resource cannot be found\");\r",
                  "\r",
                  "    pm.expect(\r",
                  "        responseText,\r",
                  "        \"Response contains Server Error page\"\r",
                  "    ).to.not.include(\"Server Error in '/' Application\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5. STRICT schema validation (AJV)\", function () {\r",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";\r",
                  "\r",
                  "    pm.expect(\r",
                  "        contentType.toLowerCase(),\r",
                  "        \"Schema validation cannot run because response is not JSON\"\r",
                  "    ).to.include(\"application/json\");\r",
                  "\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    const Ajv = require(\"ajv\");\r",
                  "    const ajv = new Ajv({ allErrors: true });\r",
                  "\r",
                  "    /*\r",
                  "      Replace this schema after getting the actual successful 200 response.\r",
                  "      Current 404 HTML response cannot be used to infer positive schema.\r",
                  "    */\r",
                  "    const schema = {\r",
                  "        type: \"object\",\r",
                  "        additionalProperties: false\r",
                  "    };\r",
                  "\r",
                  "    const isValid = ajv.validate(schema, jsonData);\r",
                  "\r",
                  "    pm.expect(\r",
                  "        isValid,\r",
                  "        JSON.stringify(ajv.errors, null, 2)\r",
                  "    ).to.be.true;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"6. Critical fields validation\", function () {\r",
                  "    pm.expect(\r",
                  "        responseText,\r",
                  "        \"Positive response was not received. API returned 404 for /api/AdminDashBoard\"\r",
                  "    ).to.not.include(\"The resource cannot be found\");\r",
                  "\r",
                  "    pm.expect(\r",
                  "        pm.response.code,\r",
                  "        \"Critical fields cannot be validated because endpoint returned error response\"\r",
                  "    ).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"7. No sensitive data exposed in response\", function () {\r",
                  "    pm.expect(\r",
                  "        containsSensitiveKeyOrValue(responseText),\r",
                  "        \"Sensitive-looking data should not be exposed in response\"\r",
                  "    ).to.be.false;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
