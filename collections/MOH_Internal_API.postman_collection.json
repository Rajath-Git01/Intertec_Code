                  "    function scan(item) {\r",
                  "        if (item === null || item === undefined) {\r",
                  "            return false;\r",
                  "        }\r",
                  "\r",
                  "        if (typeof item === \"string\") {\r",
                  "            return sensitivePatterns.some(pattern => pattern.test(item));\r",
                  "        }\r",
