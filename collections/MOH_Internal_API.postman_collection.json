                  "                const isSensitiveKey = sensitivePatterns.some(pattern => pattern.test(key));\r",
                  "                return isSensitiveKey || scan(item[key]);\r",
                  "            });\r",
                  "        }\r",
                  "\r",
                  "        return false;\r",
                  "    }\r",
