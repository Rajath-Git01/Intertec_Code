                  "\r",
                  "function hasSensitiveData(value) {\r",
                  "    const sensitivePatterns = [\r",
                  "        /password/i,\r",
                  "        /secret/i,\r",
                  "        /token/i,\r",
                  "        /authorization/i,\r",
                  "        /api[-_ ]?key/i,\r",
