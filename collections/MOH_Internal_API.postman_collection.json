        {
          "name": "GetPrevilige",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedMethod = \"POST\"; // Assumption: update if actual method is GET/PUT/etc.\r",
                  "\r",
                  "let jsonData;\r",
                  "\r",
                  "pm.test(\"0. Response body is valid JSON\", function () {\r",
                  "    pm.expect(function () {\r",
                  "        jsonData = pm.response.json();\r",
                  "    }).to.not.throw();\r",
                  "});\r",
                  "\r",
                  "function getResponseJson() {\r",
                  "    if (!jsonData) {\r",
                  "        jsonData = pm.response.json();\r",
                  "    }\r",
                  "    return jsonData;\r",
                  "}\r",
                  "\r",
                  "function hasSensitiveData(value) {\r",
                  "    const sensitiveKeyPatterns = [\r",
                  "        /password/i,\r",
                  "        /secret/i,\r",
                  "        /token/i,\r",
                  "        /authorization/i,\r",
                  "        /api[-_ ]?key/i,\r",
                  "        /private[-_ ]?key/i,\r",
                  "        /session[-_ ]?id/i,\r",
                  "        /\\botp\\b/i,\r",
                  "        /\\bpin\\b/i,\r",
                  "        /\\bcvv\\b/i,\r",
                  "        /card[-_ ]?number/i,\r",
                  "        /national[-_ ]?id/i\r",
                  "    ];\r",
                  "\r",
                  "    function scan(item) {\r",
                  "        if (item === null || item === undefined) {\r",
                  "            return false;\r",
                  "        }\r",
                  "\r",
                  "        if (typeof item === \"string\") {\r",
                  "            return sensitiveKeyPatterns.some(pattern => pattern.test(item));\r",
                  "        }\r",
                  "\r",
                  "        if (Array.isArray(item)) {\r",
                  "            return item.some(scan);\r",
                  "        }\r",
                  "\r",
                  "        if (typeof item === \"object\") {\r",
                  "            return Object.keys(item).some(key => {\r",
                  "                const isSensitiveKey = sensitiveKeyPatterns.some(pattern => pattern.test(key));\r",
                  "                return isSensitiveKey || scan(item[key]);\r",
                  "            });\r",
                  "        }\r",
                  "\r",
                  "        return false;\r",
                  "    }\r",
                  "\r",
                  "    return scan(value);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"1. Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"2. Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"3. Request method is correct\", function () {\r",
                  "    pm.expect(pm.request.method).to.eql(expectedMethod);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"4. STRICT schema validation (AJV)\", function () {\r",
                  "    const responseJson = getResponseJson();\r",
                  "\r",
                  "    const Ajv = require(\"ajv\");\r",
                  "    const ajv = new Ajv({ allErrors: true });\r",
                  "\r",
                  "    const schema = {\r",
                  "        type: \"object\",\r",
                  "        additionalProperties: false,\r",
                  "        required: [\"message\", \"errors\", \"code\", \"Data\"],\r",
                  "        properties: {\r",
                  "            message: {\r",
                  "                type: \"string\",\r",
                  "                enum: [\"success\"]\r",
                  "            },\r",
                  "            errors: {\r",
                  "                type: [\"null\", \"array\", \"object\"]\r",
                  "            },\r",
                  "            code: {\r",
                  "                type: \"integer\",\r",
                  "                enum: [200]\r",
                  "            },\r",
                  "            Data: {\r",
                  "                type: \"object\",\r",
                  "                additionalProperties: false,\r",
                  "                required: [\"TableData1\", \"TableData\", \"TotalCount\"],\r",
                  "                properties: {\r",
                  "                    TableData1: {\r",
                  "                        type: [\"null\", \"array\", \"object\"]\r",
                  "                    },\r",
                  "                    TableData: {\r",
                  "                        type: \"array\",\r",
                  "                        minItems: 1,\r",
                  "                        items: {\r",
                  "                            type: \"object\",\r",
                  "                            additionalProperties: false,\r",
