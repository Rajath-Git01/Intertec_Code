            {
              "listen": "test",
              "script": {
                "exec": [
                  "let responseJson = {};\r",
                  "\r",
                  "pm.test(\"0. Response body is valid JSON\", function () {\r",
                  "    responseJson = pm.response.json();\r",
                  "    pm.expect(responseJson).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"1. Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"2. Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"3. Request method is correct\", function () {\r",
                  "    pm.expect(pm.request.method).to.eql(\"POST\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"4. STRICT schema validation (AJV)\", function () {\r",
                  "    const Ajv = require(\"ajv\");\r",
                  "    const ajv = new Ajv({ allErrors: true });\r",
                  "\r",
                  "    const schema = {\r",
                  "        type: \"object\",\r",
                  "        additionalProperties: false,\r",
                  "        required: [\"message\", \"errors\", \"code\", \"Data\"],\r",
                  "        properties: {\r",
                  "            message: {\r",
                  "                type: \"string\",\r",
                  "                enum: [\"success\"]\r",
                  "            },\r",
                  "            errors: {\r",
                  "                type: [\"object\", \"array\", \"string\", \"null\"]\r",
                  "            },\r",
                  "            code: {\r",
                  "                type: \"integer\",\r",
                  "                enum: [200]\r",
                  "            },\r",
                  "            Data: {\r",
                  "                type: \"object\",\r",
                  "                additionalProperties: false,\r",
                  "                required: [\"TableData1\", \"TableData\", \"TotalCount\"],\r",
                  "                properties: {\r",
                  "                    TableData1: {\r",
                  "                        type: \"null\"\r",
                  "                    },\r",
                  "                    TotalCount: {\r",
                  "                        type: \"integer\",\r",
                  "                        minimum: 0\r",
                  "                    },\r",
                  "                    TableData: {\r",
                  "                        type: \"array\",\r",
                  "                        minItems: 1,\r",
                  "                        items: {\r",
                  "                            type: \"object\",\r",
                  "                            additionalProperties: false,\r",
                  "                            required: [\r",
                  "                                \"3_Code\",\r",
                  "                                \"3_Description En\",\r",
                  "                                \"3_Description Ar\",\r",
                  "                                \"3_IsActive\",\r",
                  "                                \"3_Description En1\",\r",
                  "                                \"ID\",\r",
                  "                                \"3_Created By\",\r",
                  "                                \"3_Modified By\",\r",
                  "                                \"2_Category/Id.\",\r",
                  "                                \"3_Description Ar1\",\r",
                  "                                \"ID1\"\r",
                  "                            ],\r",
                  "                            properties: {\r",
                  "                                \"3_Code\": {\r",
                  "                                    type: [\"string\", \"null\"]\r",
                  "                                },\r",
                  "                                \"3_Description En\": {\r",
                  "                                    type: \"string\",\r",
                  "                                    minLength: 1\r",
                  "                                },\r",
                  "                                \"3_Description Ar\": {\r",
                  "                                    type: \"string\",\r",
                  "                                    minLength: 1\r",
                  "                                },\r",
                  "                                \"3_IsActive\": {\r",
                  "                                    type: \"boolean\"\r",
                  "                                },\r",
                  "                                \"3_Description En1\": {\r",
                  "                                    type: \"string\",\r",
                  "                                    minLength: 1\r",
                  "                                },\r",
                  "                                \"ID\": {\r",
                  "                                    type: \"integer\",\r",
                  "                                    minimum: 1\r",
                  "                                },\r",
                  "                                \"3_Created By\": {\r",
                  "                                    type: [\"string\", \"null\"]\r",
                  "                                },\r",
                  "                                \"3_Modified By\": {\r",
                  "                                    type: [\"string\", \"null\"]\r",
                  "                                },\r",
                  "                                \"2_Category/Id.\": {\r",
                  "                                    type: \"integer\",\r",
                  "                                    minimum: 1\r",
                  "                                },\r",
                  "                                \"3_Description Ar1\": {\r",
                  "                                    type: \"string\",\r",
                  "                                    minLength: 1\r",
                  "                                },\r",
                  "                                \"ID1\": {\r",
                  "                                    type: \"integer\",\r",
                  "                                    minimum: 1\r",
                  "                                }\r",
                  "                            }\r",
                  "                        }\r",
                  "                    }\r",
                  "                }\r",
                  "            }\r",
                  "        }\r",
                  "    };\r",
                  "\r",
                  "    const isValid = ajv.validate(schema, responseJson);\r",
                  "\r",
                  "    pm.expect(\r",
                  "        isValid,\r",
                  "        JSON.stringify(ajv.errors, null, 2)\r",
                  "    ).to.be.true;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.1 Critical fields validation - top-level success response\", function () {\r",
                  "    pm.expect(responseJson).to.have.property(\"message\", \"success\");\r",
                  "    pm.expect(responseJson).to.have.property(\"code\", 200);\r",
                  "    pm.expect(responseJson).to.have.property(\"errors\", null);\r",
                  "    pm.expect(responseJson).to.have.property(\"Data\");\r",
                  "    pm.expect(responseJson.Data).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.2 Critical fields validation - Data object\", function () {\r",
                  "    pm.expect(responseJson.Data).to.have.property(\"TableData1\", null);\r",
                  "    pm.expect(responseJson.Data).to.have.property(\"TableData\");\r",
                  "    pm.expect(responseJson.Data.TableData).to.be.an(\"array\").that.is.not.empty;\r",
                  "\r",
                  "    pm.expect(responseJson.Data).to.have.property(\"TotalCount\");\r",
                  "    pm.expect(responseJson.Data.TotalCount).to.be.a(\"number\");\r",
                  "    pm.expect(responseJson.Data.TotalCount).to.be.at.least(responseJson.Data.TableData.length);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.3 Critical fields validation - each TableData item has required business fields\", function () {\r",
                  "    responseJson.Data.TableData.forEach(function (item, index) {\r",
                  "        pm.expect(item, \"Item \" + index).to.have.property(\"3_Description En\");\r",
                  "        pm.expect(item[\"3_Description En\"], \"English description at item \" + index)\r",
                  "            .to.be.a(\"string\")\r",
                  "            .and.not.empty;\r",
                  "\r",
                  "        pm.expect(item, \"Item \" + index).to.have.property(\"3_Description Ar\");\r",
                  "        pm.expect(item[\"3_Description Ar\"], \"Arabic description at item \" + index)\r",
                  "            .to.be.a(\"string\")\r",
                  "            .and.not.empty;\r",
                  "\r",
                  "        pm.expect(item, \"Item \" + index).to.have.property(\"3_Description En1\");\r",
                  "        pm.expect(item[\"3_Description En1\"], \"Category English description at item \" + index)\r",
                  "            .to.be.a(\"string\")\r",
                  "            .and.not.empty;\r",
                  "\r",
                  "        pm.expect(item, \"Item \" + index).to.have.property(\"3_Description Ar1\");\r",
                  "        pm.expect(item[\"3_Description Ar1\"], \"Category Arabic description at item \" + index)\r",
                  "            .to.be.a(\"string\")\r",
                  "            .and.not.empty;\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.4 Critical fields validation - IDs and category IDs are valid\", function () {\r",
                  "    responseJson.Data.TableData.forEach(function (item, index) {\r",
                  "        pm.expect(item.ID, \"ID at item \" + index).to.be.a(\"number\").and.to.be.above(0);\r",
                  "        pm.expect(item.ID1, \"ID1 at item \" + index).to.be.a(\"number\").and.to.be.above(0);\r",
                  "        pm.expect(item[\"2_Category/Id.\"], \"Category ID at item \" + index)\r",
                  "            .to.be.a(\"number\")\r",
                  "            .and.to.be.above(0);\r",
                  "\r",
                  "        pm.expect(\r",
                  "            item.ID,\r",
                  "            \"ID should match 2_Category/Id. at item \" + index\r",
                  "        ).to.eql(item[\"2_Category/Id.\"]);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.5 Critical fields validation - ID1 values are unique\", function () {\r",
                  "    const id1Values = responseJson.Data.TableData.map(function (item) {\r",
                  "        return item.ID1;\r",
                  "    });\r",
                  "\r",
                  "    const uniqueId1Values = new Set(id1Values);\r",
                  "\r",
                  "    pm.expect(\r",
                  "        uniqueId1Values.size,\r",
                  "        \"Duplicate ID1 values found\"\r",
                  "    ).to.eql(id1Values.length);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5.6 Critical fields validation - active status is boolean\", function () {\r",
                  "    responseJson.Data.TableData.forEach(function (item, index) {\r",
                  "        pm.expect(item[\"3_IsActive\"], \"3_IsActive at item \" + index).to.be.a(\"boolean\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"6. No sensitive data exposed in response\", function () {\r",
                  "    const sensitiveKeyPattern = /(^|[_\\-\\s.\\/])(password|secret|token|authorization|apiKey|privateKey|sessionId|otp|pin|cvv|cardNumber|nationalId|accessToken|refreshToken)([_\\-\\s.\\/]|$)/i;\r",
                  "    const jwtPattern = /^eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/;\r",
                  "    const bearerPattern = /^Bearer\\s+[A-Za-z0-9._-]+$/i;\r",
                  "\r",
                  "    function luhnCheck(value) {\r",
                  "        const digits = String(value).replace(/\\D/g, \"\");\r",
                  "\r",
                  "        if (digits.length < 13 || digits.length > 19) {\r",
                  "            return false;\r",
                  "        }\r",
                  "\r",
                  "        let sum = 0;\r",
                  "        let shouldDouble = false;\r",
                  "\r",
                  "        for (let i = digits.length - 1; i >= 0; i--) {\r",
                  "            let digit = parseInt(digits.charAt(i), 10);\r",
                  "\r",
                  "            if (shouldDouble) {\r",
                  "                digit *= 2;\r",
                  "                if (digit > 9) {\r",
                  "                    digit -= 9;\r",
                  "                }\r",
                  "            }\r",
                  "\r",
                  "            sum += digit;\r",
                  "            shouldDouble = !shouldDouble;\r",
                  "        }\r",
                  "\r",
                  "        return sum % 10 === 0;\r",
                  "    }\r",
                  "\r",
                  "    function scanForSensitiveData(value, path, findings) {\r",
                  "        if (Array.isArray(value)) {\r",
                  "            value.forEach(function (arrayItem, index) {\r",
                  "                scanForSensitiveData(arrayItem, path + \"[\" + index + \"]\", findings);\r",
                  "            });\r",
                  "            return;\r",
                  "        }\r",
                  "\r",
                  "        if (value !== null && typeof value === \"object\") {\r",
                  "            Object.keys(value).forEach(function (key) {\r",
                  "                const currentPath = path ? path + \".\" + key : key;\r",
                  "\r",
                  "                if (sensitiveKeyPattern.test(key)) {\r",
                  "                    findings.push(\"Sensitive-looking key found: \" + currentPath);\r",
                  "                }\r",
                  "\r",
                  "                scanForSensitiveData(value[key], currentPath, findings);\r",
                  "            });\r",
                  "            return;\r",
                  "        }\r",
                  "\r",
                  "        if (typeof value === \"string\") {\r",
                  "            if (jwtPattern.test(value)) {\r",
                  "                findings.push(\"JWT-like token found at: \" + path);\r",
                  "            }\r",
                  "\r",
                  "            if (bearerPattern.test(value)) {\r",
                  "                findings.push(\"Bearer token found at: \" + path);\r",
                  "            }\r",
                  "\r",
                  "            if (luhnCheck(value)) {\r",
                  "                findings.push(\"Possible full card number found at: \" + path);\r",
                  "            }\r",
                  "        }\r",
                  "    }\r",
                  "\r",
                  "    const findings = [];\r",
                  "    scanForSensitiveData(responseJson, \"\", findings);\r",
                  "\r",
                  "    pm.expect(\r",
                  "        findings,\r",
                  "        \"Sensitive data exposure found: \" + findings.join(\", \")\r",
                  "    ).to.be.empty;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
